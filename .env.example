# Copy to .env and fill in real values. NEVER commit real secrets — .env is gitignored.
# Only variable NAMES belong in this template; leave values blank.

# Absolute http/https origin used for OAuth redirects and absolute signed URLs.
PUBLIC_ORIGIN=

# HMAC secret for local object-storage signed URLs.
# REQUIRED outside Development (in compose it is passed as OBJECT_STORAGE_SIGNING_SECRET).
OBJECT_STORAGE_SIGNING_SECRET=

# FASHN virtual try-on provider. Opt in by also setting the provider:
#   TryOn__Provider=Fashn
FASHN_API_KEY=
FASHN_BASE_URL=
FASHN_MODEL_NAME=
FASHN_MODE=
# Output resolution: 1k (default, 2 credits) or 4k (5 credits).
FASHN_RESOLUTION=
FASHN_OUTPUT_FORMAT=
# Optional; empty by default. Only for garment-styling experiments, not for dictating gender.
FASHN_GENDER_PROMPT_TEMPLATE=

# Google OAuth (sign-in is enabled only when these are configured).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OIDC (sign-in is enabled only when these are configured).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Host ports of the production frontend container (blank = defaults 80/443).
# Override when another stack on the same machine already binds 80/443.
FRONTEND_HTTP_PORT=
FRONTEND_HTTPS_PORT=
