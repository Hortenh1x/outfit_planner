# Copy to .env and fill in real values. NEVER commit real secrets — .env is gitignored.
# Only variable NAMES belong in this template; leave values blank.

# Absolute http/https origin used for OAuth redirects and absolute signed URLs.
PUBLIC_ORIGIN=

# HMAC secret for local object-storage signed URLs.
# REQUIRED outside Development (in compose it is passed as OBJECT_STORAGE_SIGNING_SECRET).
OBJECT_STORAGE_SIGNING_SECRET=

# FASHN virtual try-on provider. Opt in by also setting the provider:
#   TryOn__Provider=Fashn
FASHN_API_KEY=
FASHN_BASE_URL=
FASHN_MODEL_NAME=
FASHN_MODE=
# Output resolution: 1k (default, 2 credits) or 4k (5 credits).
FASHN_RESOLUTION=
FASHN_OUTPUT_FORMAT=
# Optional; empty by default. Only for garment-styling experiments, not for dictating gender.
FASHN_GENDER_PROMPT_TEMPLATE=

# Google OAuth (sign-in is enabled only when these are configured).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OIDC (sign-in is enabled only when these are configured).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Host ports of the production frontend container (blank = defaults 80/443).
# Override when another stack on the same machine already binds 80/443.
FRONTEND_HTTP_PORT=
FRONTEND_HTTPS_PORT=

# Stripe billing (paywall stage 4). Billing activates when STRIPE_SECRET_KEY is set;
# leave everything blank to keep billing softly disabled. Start with TEST-mode keys
# (sk_test_...) and follow README -> Verification -> "Stripe test-mode end-to-end runbook".
BILLING_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_MONTHLY_DISPLAY_PRICE=
# Top-up pack price ids (a pack without a price id is not offered on /upgrade).
STRIPE_TOPUP_PACK_20_PRICE_ID=
STRIPE_TOPUP_PACK_20_DISPLAY_PRICE=
STRIPE_TOPUP_PACK_50_PRICE_ID=
STRIPE_TOPUP_PACK_50_DISPLAY_PRICE=
STRIPE_TOPUP_PACK_100_PRICE_ID=
STRIPE_TOPUP_PACK_100_DISPLAY_PRICE=

# Role pins (comma-separated emails). The owner admin pin is built into the API; Premium
# pins exist only here (no other person's email ships in the source).
ROLES_PINNED_ADMIN_EMAILS=
ROLES_PINNED_PREMIUM_EMAILS=

# Password reset emails (plain SMTP, STARTTLS on 587 by default). Leave SMTP_HOST empty to keep
# the feature disabled; the sign-in page then tells users to contact the administrator instead.
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Outfit Planner

# Garment background removal. Leave BACKGROUND_REMOVAL_PROVIDER empty for the stack default
# (rembg container on the self-host/Oracle stacks, built-in keyer otherwise); set it to Fal and
# put your fal.ai key in FAL_KEY to use the hosted BRIA RMBG 2.0 model.
BACKGROUND_REMOVAL_PROVIDER=
FAL_KEY=
